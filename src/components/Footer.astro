<script>
  function updateAdminFooter() {
    const isAdmin = localStorage.getItem('tt_admin_logged_in') === 'true';
    const footerLinks = document.querySelectorAll('.admin-only-footer-link');
    const adminEntry = document.getElementById('footer-admin-entry');
    
    footerLinks.forEach(el => {
      (el as HTMLElement).style.display = isAdmin ? 'block' : 'none';
    });

    if (adminEntry) {
      if (isAdmin) {
        adminEntry.textContent = '🟢 Admin Mode';
        adminEntry.style.color = '#38bdf8';
        adminEntry.style.opacity = '1';
      } else {
        adminEntry.textContent = '🔒 Quản trị';
        adminEntry.style.color = '#64748b';
        adminEntry.style.opacity = '0.6';
      }
    }
  }

  window.addEventListener('admin-auth-changed', updateAdminFooter);
  window.addEventListener('storage', updateAdminFooter);
  updateAdminFooter();
</script>
